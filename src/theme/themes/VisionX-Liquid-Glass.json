  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#627294",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#ff2a85",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Flow Keywords",
      "scope": ["keyword.control", "keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.control.default"],
      "settings": {
        "foreground": "#ff2a85",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "entity.name.function.member"],
      "settings": {
        "foreground": "#00e5ff"
      }
    },
    {
      "name": "Strings & Template Literals",
      "scope": ["string", "string.quoted", "punctuation.definition.string", "string.template"],
      "settings": {
        "foreground": "#ffd166"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class"],
      "settings": {
        "foreground": "#00f5d4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": ["variable", "variable.other", "variable.parameter", "meta.definition.variable"],
      "settings": {
        "foreground": "#f1f5f9"
      }
    },
    {
      "name": "Constants & Numbers",
      "scope": ["constant", "constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#ff5588",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags & JSX Elements",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#ff6600",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#facc15"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#38bdf8"
      }
    }
  ]
}
