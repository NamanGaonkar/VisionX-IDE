{
  "name": "visionx-ai-assistant",
  "displayName": "VisionX Chat",
  "description": "Native Copilot-style Chat & Autonomous Coding for VisionX IDE",
  "version": "1.3.0",
  "publisher": "VisionX",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "categories": [
    "Machine Learning",
    "Programming Languages"
  ],
  "activationEvents": [
    "onView:visionx.aiView",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visionx-ai",
          "title": "Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "visionx-ai": [
        {
          "type": "webview",
          "id": "visionx.aiView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "visionx.askAI",
        "title": "VisionX: Open Chat",
        "category": "VisionX"
      },
      {
        "command": "visionx.explainCode",
        "title": "VisionX: Explain Selected Code",
        "category": "VisionX"
      },
      {
        "command": "visionx.refactorCode",
        "title": "VisionX: Refactor Selection",
        "category": "VisionX"
      },
      {
        "command": "visionx.fixErrors",
        "title": "VisionX: Detect & Fix Bugs",
        "category": "VisionX"
      },
      {
        "command": "visionx.importFromVSCode",
        "title": "VisionX: Import Settings & Keybindings from Visual Studio Code",
        "category": "VisionX"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "visionx.explainCode",
          "group": "visionx@1",
          "when": "editorHasSelection"
        },
        {
          "command": "visionx.refactorCode",
          "group": "visionx@2",
          "when": "editorHasSelection"
        },
        {
          "command": "visionx.fixErrors",
          "group": "visionx@3",
          "when": "editorHasSelection"
        }
      ]
    }
  }
}
