{
  "name": "visionx-ai-assistant",
  "displayName": "VisionX Chat & 3D Project Architecture",
  "description": "Native Copilot-style Chat, Sessions, and 3D Project Architecture Graph for VisionX IDE",
  "version": "1.6.5",
  "publisher": "VisionX",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onView:visionx.aiView",
    "onView:visionx.graphView",
    "onCommand:visionx.askAI",
    "onCommand:visionx.openProjectGraph",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visionx-ai",
          "title": "Chat",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "visionx-graph-panel",
          "title": "Project Architecture Graph",
          "icon": "media/graph-icon.svg"
        }
      ]
    },
    "views": {
      "visionx-ai": [
        {
          "type": "webview",
          "id": "visionx.aiView",
          "name": "Chat"
        }
      ],
      "visionx-graph-panel": [
        {
          "type": "webview",
          "id": "visionx.graphView",
          "name": "3D Project Architecture Graph"
        }
      ]
    },
    "commands": [
      {
        "command": "visionx.askAI",
        "title": "VisionX: Open Chat",
        "category": "VisionX",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "visionx.openProjectGraph",
        "title": "VisionX: Open 3D Project Architecture Graph",
        "category": "VisionX",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "visionx.explainCode",
        "title": "VisionX: Explain Selected Code",
        "category": "VisionX"
      },
      {
        "command": "visionx.refactorCode",
        "title": "VisionX: Refactor Selection",
        "category": "VisionX"
      },
      {
        "command": "visionx.fixErrors",
        "title": "VisionX: Detect & Fix Bugs",
        "category": "VisionX"
      },
      {
        "command": "visionx.importFromVSCode",
        "title": "VisionX: Import Settings & Keybindings from Visual Studio Code",
        "category": "VisionX"
      }
    ],
    "menus": {
      "commandCenter": [
        {
          "command": "visionx.askAI",
          "group": "navigation@100"
        },
        {
          "command": "visionx.openProjectGraph",
          "group": "navigation@101"
        }
      ],
      "editor/context": [
        {
          "command": "visionx.explainCode",
          "group": "visionx@1",
          "when": "editorHasSelection"
        },
        {
          "command": "visionx.refactorCode",
          "group": "visionx@2",
          "when": "editorHasSelection"
        },
        {
          "command": "visionx.fixErrors",
          "group": "visionx@3",
          "when": "editorHasSelection"
        }
      ]
    }
  }
}
